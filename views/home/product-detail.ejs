<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../includes/meta') %>
  </head>

  <body>
    <%- include('../includes/header') %>
    <main class="centered">
      <h1><%= product.title %></h1>
      <hr />
      <img
        src="<%= product.imageUrl %>"
        alt="<%= product.title %>"
        class="product-image"
      />
      <p><%= product.description %></p>
      <h3>Price: $<%= product.price %></h3>
      <%- include('../includes/add-to-cart.ejs', { productId: product.id }) %>
    </main>
    <%- include('../includes/scripts.ejs') %>
  </body>
</html>
